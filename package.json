{
  "name": "ngx-progress-overlay-ws",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "build_lib": "ng build ngx-progress-overlay --configuration production",
    "copy-license": "node -e \"require('fs').copyFileSync('LICENSE', 'dist/ngx-progress-overlay/LICENSE')\"",
    "copy-readme": "node -e \"require('fs').copyFileSync('README.md', 'dist/ngx-progress-overlay/README.md')\"",
    "copy-files": "npm run copy-license && npm run copy-readme",
    "npm_pack": "cd dist/ngx-progress-overlay && npm pack",
    "package": "npm run build_lib && npm run copy-files && npm run npm_pack",
    "publish_lib": "cd dist/ngx-progress-overlay && npm publish --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.14",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.14",
    "@angular/compiler": "~21.2.14",
    "@angular/core": "~21.2.14",
    "@angular/forms": "~21.2.14",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "~21.2.14",
    "@angular/platform-browser-dynamic": "~21.2.14",
    "@angular/router": "~21.2.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.14",
    "@angular/cli": "~21.2.14",
    "@angular/compiler-cli": "~21.2.14",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.3"
  }
}
